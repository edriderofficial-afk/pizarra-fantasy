{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": [],
      "env": ["TEST_DATABASE_URL"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL"]
    }
  }
}
