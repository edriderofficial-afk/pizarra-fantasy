# Copy to .env.local (web) / apps/mobile/.env and fill in. Never commit real values.

# --- Data source ---
# mock | fantasy   (Phase 0-1: always mock)
EXPO_PUBLIC_DATA_PROVIDER=mock
NEXT_PUBLIC_DATA_PROVIDER=mock

# --- Supabase (Phase 2+) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (ingest workers / CI). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Provider id hashing (Phase 2+) ---
PROVIDER_ID_HMAC_SECRET=

# --- Observability / monetization (Phase 5) ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Ingest / tests (server only) ---
# mock | (Phase 2B) fantasy-public
INGEST_PROVIDER=mock
# Superuser URL of any Postgres; tests create and drop throwaway databases
TEST_DATABASE_URL=
