{
  "name": "pizarra",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "har:types": "tsx scripts/har-to-types.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@pizarra/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "@pizarra/data": "workspace:*",
    "@types/node": "22.20.5"
  }
}
